    { "level": "L2", "services": 5, "cwp_direct": 4, "gateway_translated": 1, "fault_overlay": "none" },
    { "level": "L3", "services": 10, "cwp_direct": 8, "gateway_translated": 2, "fault_overlay": "rtp_loss_minor" },
    { "level": "L4", "services": 30, "cwp_direct": 24, "gateway_translated": 6, "fault_overlay": "mixed_minor" },
    { "level": "L5", "services": 50, "cwp_direct": 40, "gateway_translated": 10, "fault_overlay": "mixed_operational" },
    { "level": "L6", "services": 100, "cwp_direct": 80, "gateway_translated": 20, "fault_overlay": "capacity_challenge", "optional": true }
